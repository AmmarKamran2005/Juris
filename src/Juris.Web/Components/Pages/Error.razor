@page "/Error"

<PageTitle>Something broke · Juris</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex" />
</HeadContent>

<section class="j-section" style="padding: var(--s-12) 0;">
    <div class="j-container j-text-center" style="max-width: 60ch;">
        <div class="j-eyebrow">500 · Internal Error</div>
        <h1 style="font-size: clamp(48px, 8vw, 96px); margin-top: 16px;">Something broke.</h1>
        <p class="j-lede" style="margin: 24px auto;">
            We've been notified. If this keeps happening, email <a href="mailto:editorial@juris.local" class="j-plain">editorial@juris.local</a>.
        </p>
        <div class="j-flex" style="justify-content:center; gap:12px; margin-top:32px;">
            <a href="/" class="j-button j-primary j-plain">← Home</a>
        </div>
    </div>
</section>
