@page "/Account/ResetPasswordConfirmation"

<PageTitle>Password reset · Juris</PageTitle>

<section class="j-section" style="padding: var(--s-12) 0;">
    <div class="j-container j-text-center" style="max-width: 56ch;">
        <div class="j-eyebrow">Done</div>
        <h1 style="margin-top: 16px;">Password reset.</h1>
        <p class="j-lede" style="margin: 24px auto;">You can now sign in with your new password.</p>
        <div class="j-flex" style="justify-content:center; gap:12px; margin-top:32px;">
            <a href="/Account/Login" class="j-button j-primary j-plain">Sign in →</a>
        </div>
    </div>
</section>
