@page "/Account/ForgotPasswordConfirmation"

<PageTitle>Check your email · Juris</PageTitle>

<section class="j-section" style="padding: var(--s-12) 0;">
    <div class="j-container j-text-center" style="max-width: 56ch;">
        <div class="j-eyebrow">Reset Sent</div>
        <h1 style="margin-top: 16px;">Check your email.</h1>
        <p class="j-lede" style="margin: 24px auto;">
            If an account exists for that address, a reset link is on its way.
        </p>
        <div class="j-flex" style="justify-content:center; gap:12px; margin-top:32px;">
            <a href="/Account/Login" class="j-button j-primary j-plain">← Back to sign in</a>
        </div>
    </div>
</section>
